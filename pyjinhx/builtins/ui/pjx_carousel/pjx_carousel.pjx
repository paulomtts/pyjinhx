<div id="{{ id }}" role="region" aria-roledescription="carousel" aria-label="{{ label }}" class="pjx-carousel{% if class_name %} {{ class_name }}{% endif %}" data-pjx-carousel{% if loop %} data-pjx-carousel-loop{% endif %}{% if autoplay %} data-pjx-carousel-autoplay data-pjx-carousel-interval="{{ interval_ms }}"{% endif %}{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}><div class="pjx-carousel__track" tabindex="0">{% if content is iterable and content is not string %}{% for slide in content %}{{ slide }}{% endfor %}{% else %}{{ content }}{% endif %}</div><button type="button" class="pjx-carousel__arrow pjx-carousel__arrow--prev" aria-label="{{ prev_label }}" data-pjx-carousel-prev>{{ prev_icon }}</button><button type="button" class="pjx-carousel__arrow pjx-carousel__arrow--next" aria-label="{{ next_label }}" data-pjx-carousel-next>{{ next_icon }}</button><div class="pjx-carousel__dots" data-pjx-carousel-dots></div>{% if autoplay %}<button type="button" class="pjx-carousel__autoplay-toggle" aria-label="{{ autoplay_toggle_label }}" data-pjx-carousel-autoplay-toggle>{{ pause_icon }}{{ play_icon }}</button>{% endif %}</div>