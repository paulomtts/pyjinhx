{% set _tag = "form" if as_form else "div" -%}
<{{ _tag }} id="{{ id }}" class="pjx-popover__panel{% if class_name %} {{ class_name }}{% endif %}" data-pjx-popover-panel hidden{% if role %} role="{{ role }}"{% endif %}{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}>{{ content }}</{{ _tag }}>