<div id="{{ id }}" role="group" aria-label="{{ aria_label }}" class="pjx-graph{% if class_name %} {{ class_name }}{% endif %}" data-pjx-graph{% if storage_key %} data-pjx-graph-storage-key="{{ storage_key }}"{% endif %} data-pjx-graph-scale-min="{{ scale_min }}" data-pjx-graph-scale-max="{{ scale_max }}"{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}><div class="pjx-graph__canvas"><div class="pjx-graph__viewport"><svg class="pjx-graph__edge-plane" aria-hidden="true"></svg>{{ nodes }}{{ edges }}</div>{{ controls }}</div>{{ panel }}</div>
