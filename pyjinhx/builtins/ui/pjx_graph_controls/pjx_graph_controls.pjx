<div id="{{ id }}" role="group" aria-label="{{ aria_label }}" class="pjx-graph__controls{% if class_name %} {{ class_name }}{% endif %}" data-pjx-graph-controls{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}><button type="button" class="pjx-graph__control" data-pjx-graph-zoom="in" aria-label="{{ zoom_in_label }}">{{ zoom_in_label }}</button><button type="button" class="pjx-graph__control" data-pjx-graph-zoom="out" aria-label="{{ zoom_out_label }}">{{ zoom_out_label }}</button><button type="button" class="pjx-graph__control" data-pjx-graph-fit aria-label="{{ fit_label }}">{{ fit_label }}</button></div>
