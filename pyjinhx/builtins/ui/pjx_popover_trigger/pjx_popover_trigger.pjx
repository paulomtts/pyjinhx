<{{ tag }} id="{{ id }}" class="pjx-popover__trigger{% if class_name %} {{ class_name }}{% endif %}"{% if tag == "button" %} type="button"{% else %} role="button" tabindex="0"{% endif %} data-pjx-toggle aria-expanded="false"{% if role %} aria-haspopup="{{ role }}"{% endif %}{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}>{{ content }}</{{ tag }}>