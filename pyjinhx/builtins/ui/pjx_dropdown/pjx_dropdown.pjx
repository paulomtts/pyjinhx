<div id="{{ id }}" class="pjx-dropdown{% if align == "end" %} pjx-dropdown--align-end{% endif %}{% if class_name %} {{ class_name }}{% endif %}" data-pjx-popover{% if portal %} data-pjx-popover-portal{% endif %}><button id="{{ id }}-trigger" class="pjx-dropdown__trigger" type="button" aria-expanded="false" aria-haspopup="menu" aria-controls="{{ id }}-menu" data-pjx-toggle="{{ id }}-menu">{{ trigger }}</button><div id="{{ id }}-menu" class="pjx-dropdown__menu" data-pjx-popover-panel role="menu" aria-label="{{ menu_label }}" hidden>{% for item in items %}{{ item }}{% endfor %}</div></div>
