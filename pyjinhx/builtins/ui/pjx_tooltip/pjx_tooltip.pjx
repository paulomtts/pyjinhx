<span id="{{ id }}" class="pjx-tooltip{% if class_name %} {{ class_name }}{% endif %}" data-pjx-tooltip-placement="{{ placement }}"{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}>{% if backdrop %}<span class="pjx-tooltip__backdrop" data-pjx-tooltip-backdrop hidden></span>{% endif %}{% if content is iterable and content is not string %}{% for child in content %}{{ child }}{% endfor %}{% else %}{{ content }}{% endif %}</span>