{% if orientation == 'vertical' %}
<div id="{{ id }}"
     class="pjx-divider pjx-divider--vertical{% if class_name %} {{ class_name }}{% endif %}"
     role="separator"
     aria-orientation="vertical"
     {% if label %}aria-label="{{ label }}"{% endif %}{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}></div>
{% elif label %}
<div id="{{ id }}" class="pjx-divider pjx-divider--labeled{% if class_name %} {{ class_name }}{% endif %}" role="presentation"{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}>
  <span class="pjx-divider__line" aria-hidden="true"></span>
  <span class="pjx-divider__label">{{ label }}</span>
  <span class="pjx-divider__line" aria-hidden="true"></span>
</div>
{% else %}
<hr id="{{ id }}"
    class="pjx-divider pjx-divider--horizontal{% if class_name %} {{ class_name }}{% endif %}"
    role="separator"
    aria-orientation="horizontal"{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %} />
{% endif %}
