<div id="{{ id }}" class="pjx-stack pjx-stack--{{ direction }} pjx-stack--gap-{{ gap }}{% if align %} pjx-stack--align-{{ align }}{% endif %}{% if justify %} pjx-stack--justify-{{ justify }}{% endif %}{% if wrap %} pjx-stack--wrap{% endif %}{% if class_name %} {{ class_name }}{% endif %}"{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}>{{ content }}</div>
