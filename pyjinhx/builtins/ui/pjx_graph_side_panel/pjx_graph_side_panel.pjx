<aside id="{{ id }}" aria-label="{{ aria_label }}" class="pjx-graph__panel" data-pjx-graph-panel data-open="{{ 'true' if open else 'false' }}"><header class="pjx-graph__panel-head" data-pjx-graph-panel-head><button type="button" class="pjx-graph__panel-control" data-pjx-graph-panel-back aria-label="{{ back_label }}" hidden>{{ back_label }}</button><h2 class="pjx-graph__panel-title" data-pjx-graph-panel-title>{{ title }}</h2><button type="button" class="pjx-graph__panel-control" data-pjx-graph-panel-close aria-label="{{ close_label }}">{{ close_label }}</button></header><div class="pjx-graph__panel-content" data-pjx-graph-panel-content></div></aside>
