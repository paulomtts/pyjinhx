<aside id="{{ id }}" aria-label="{{ aria_label }}" class="pjx-graph__panel{% if class_name %} {{ class_name }}{% endif %}" data-pjx-graph-panel data-open="{{ 'true' if open else 'false' }}"{% if accent_color %} style="--pjx-graph-panel-accent: {{ accent_color }}"{% endif %}{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}><header class="pjx-graph__panel-head" data-pjx-graph-panel-head><button type="button" class="pjx-graph__panel-control" data-pjx-graph-panel-back aria-label="{{ back_label }}" hidden>{{ back_label }}</button>{% if marker %}<span class="pjx-graph__panel-marker" data-pjx-graph-panel-marker aria-hidden="true"></span>{% endif %}<h2 class="pjx-graph__panel-title" data-pjx-graph-panel-title>{{ title }}</h2>{% if badge %}<span class="pjx-graph__panel-badge" data-pjx-graph-panel-badge>{{ badge }}</span>{% endif %}<button type="button" class="pjx-graph__panel-control" data-pjx-graph-panel-close aria-label="{{ close_label }}">{{ close_label }}</button></header><div class="pjx-graph__panel-content" data-pjx-graph-panel-content>{{ content }}</div></aside>
