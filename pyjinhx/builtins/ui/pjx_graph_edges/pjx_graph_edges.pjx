<div id="{{ id }}" class="pjx-graph__edges{% if class_name %} {{ class_name }}{% endif %}" hidden{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}>{% for edge in edges %}<span hidden data-pjx-graph-edge data-edge-id="{{ edge["id"] }}" data-from="{{ edge["from"] }}" data-to="{{ edge["to"] }}" data-port="{{ edge.get("port", "") }}"{% if edge.get("to_port") %} data-to-port="{{ edge["to_port"] }}"{% endif %}{% if edge.get("kind") %} data-kind="{{ edge["kind"] }}"{% endif %} data-state="{{ edge.get("state", "") }}" data-label="{{ edge.get("label", "") }}"></span>{% endfor %}</div>
