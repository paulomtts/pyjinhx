<div id="{{ id }}" class="pjx-popover{% if align == "end" %} pjx-popover--align-end{% endif %}{% if class_name %} {{ class_name }}{% endif %}" data-pjx-popover{% if portal %} data-pjx-popover-portal{% endif %}{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}>{{ content }}</div>