<div id="{{ id }}" role="group" class="pjx-resizable-group pjx-resizable-group--{{ direction }}{% if class_name %} {{ class_name }}{% endif %}" data-pjx-resizable-group data-direction="{{ direction }}">{% if content is iterable and content is not string %}{% for child in content %}{{ child }}{% endfor %}{% else %}{{ content }}{% endif %}</div>