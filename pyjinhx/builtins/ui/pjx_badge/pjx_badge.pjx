<span id="{{ id }}" class="pjx-badge pjx-badge--{{ color }} pjx-badge--{{ shape }}{% if removable %} pjx-badge--removable{% endif %}{% if class_name %} {{ class_name }}{% endif %}"{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}>{{ label }}{% if removable %}<button type="button" class="pjx-badge__remove" aria-label="{{ remove_label }}" data-pjx-badge-remove{% for name, value in remove_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}>&times;</button>{% endif %}</span>