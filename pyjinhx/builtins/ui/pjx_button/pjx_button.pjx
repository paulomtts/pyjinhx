<button id="{{ id }}" type="{{ type }}" class="pjx-button pjx-button--{{ variant }}{% if block %} pjx-button--block{% endif %}{% if class_name %} {{ class_name }}{% endif %}"{% if disabled or loading %} disabled{% endif %}{% if loading %} aria-busy="true"{% endif %}{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}>{{ content }}{% if loading %}{{ loader }}{% endif %}</button>
