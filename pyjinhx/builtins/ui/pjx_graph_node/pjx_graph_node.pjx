<div id="{{ id }}" class="pjx-graph__node{% if class_name %} {{ class_name }}{% endif %}" data-node-id="{{ node_id }}" data-node-type="{{ node_type }}" data-x="{{ x }}" data-y="{{ y }}" style="--pjx-graph-node-x:{{ x }}px;--pjx-graph-node-y:{{ y }}px;{% if color %}--pjx-graph-node-color:{{ color }};{% endif %}"{% for name, value in extra_attrs.items() %} {{ name }}="{{ value }}"{% endfor %}>{% if in_port %}<span class="pjx-graph__port pjx-graph__port--in" data-pjx-graph-port="in"></span>{% endif %}{% if icon %}<span class="pjx-graph__node-icon">{{ icon }}</span>{% endif %}<div class="pjx-graph__node-body">{% if eyebrow %}<span class="pjx-graph__node-eyebrow">{{ eyebrow }}</span>{% endif %}<span class="pjx-graph__node-title">{{ title }}</span>{% if summary is not none %}<p class="pjx-graph__node-summary">{{ summary }}</p>{% endif %}</div>{% if out_ports %}<div class="pjx-graph__node-ports">{% for key in out_ports %}<span class="pjx-graph__port pjx-graph__port--out" data-pjx-graph-port="out" data-port="{{ key }}"></span>{% endfor %}</div>{% endif %}</div>
