{#python
from pyjinhx import BaseComponent


class NameField(BaseComponent):
    """A form's required name input and the error under it.

    An answer swaps it out of band (``oob``) with the posted value, so the
    error changes without touching the rest of the form. Each form subclasses
    it with its own input id and label.
    """

    auto_id = False

    input_id: str = ""
    label: str = ""
    value: str = ""
    error: str = ""
    oob: bool = False


class ProjectNameField(NameField):
    input_id: str = "project-name"
    label: str = "Project"


class TeamNameField(NameField):
    input_id: str = "team-name"
    label: str = "Team"


class OwnerNameField(NameField):
    input_id: str = "owner-name"
    label: str = "Owner"


class ListNameField(NameField):
    input_id: str = "list-name"
    label: str = "List"


class TagNameField(NameField):
    input_id: str = "tag-name"
    label: str = "Tag"


class LabelNameField(NameField):
    input_id: str = "label-name"
    label: str = "Label"
#}
<div id="{{ id }}" class="name-field"{% if oob %} hx-swap-oob="outerHTML"{% endif %}>
  <label for="{{ input_id }}">{{ label }}</label>
  <input id="{{ input_id }}" name="name" value="{{ value }}"{% if error %} aria-invalid="true"{% endif %}>
  {% if error %}<p class="field-error" role="alert">{{ error }}</p>{% endif %}
</div>
